index 0000000..7fe790e
--- /dev/null
+++ b/apps/atlas/src/routes/_authenticated/dev/3d.tsx
@@ -0,0 +1,52 @@
+import { Link, createFileRoute, redirect } from "@tanstack/react-router";
+import { z } from "zod";
+import { Spike3dPage, variants } from "@/features/spike-3d/spike-3d-page";
+
+export const Route = createFileRoute("/_authenticated/dev/3d")({
+  validateSearch: z.object({
+    variant: z.enum(variants).catch("map-only"),
+    basemap: z.enum(["bright", "liberty"]).catch("bright"),
+  }),
+  beforeLoad: ({ context }) => {
+    if (context.user.role !== "admin") throw redirect({ to: "/" });
+  },
+  component: Page,
+});
+
+function Page() {
+  const { variant, basemap } = Route.useSearch();
+  return (
+    <div className="flex h-[calc(100svh-var(--site-header-height))] flex-col">
+      <nav className="flex flex-wrap items-center gap-3 border-b px-3 py-2 text-sm">
+        <Link to="/" className="underline underline-offset-4">
+          ← Home
+        </Link>
+        <span className="text-muted-foreground">3D renderer spike:</span>
+        {variants.map((v) => (
+          <Link
+            key={v}
+            to="/dev/3d"
+            search={{ variant: v, basemap }}
+            className={v === variant ? "font-semibold" : "underline underline-offset-4"}
+          >
+            {v}
+          </Link>
+        ))}
+        <span className="text-muted-foreground">basemap:</span>
+        {(["bright", "liberty"] as const).map((b) => (
+          <Link
+            key={b}
+            to="/dev/3d"
+            search={{ variant, basemap: b }}
+            className={b === basemap ? "font-semibold" : "underline underline-offset-4"}
+          >
+            {b}
+          </Link>
+        ))}
+      </nav>
+      <div className="min-h-0 flex-1">
+        <Spike3dPage key={`${variant}-${basemap}`} variant={variant} basemap={basemap} />
+      </div>
+    </div>
+  );
+}
