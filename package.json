    "@kitware/vtk.js": "36.12.1",
    "@loaders.gl/gltf": "4.4.5",
    "@luma.gl/core": "9.4.0",
    "cesium": "1.145.0",
    "maplibre-gl": "6.8.0",
    "playcanvas": "2.22.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
