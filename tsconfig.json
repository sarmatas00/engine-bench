{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["vite/client", "bun-types", "geojson"],
    "paths": {"@lib/*": ["./src/lib/*"]},
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "pages", "scripts", "tests"]
}
